# Secretos: el repositorio es público. Las llaves de WireGuard, la CA de Caddy
# y las contraseñas de Ansible se generan en el servidor y nunca se versionan.
*.key
*.pem
*.crt
privatekey
publickey
presharedkey
wg*.conf
.env
*.env
.vault_pass*
secrets/

# La CA interna de Caddy vive en un volumen de Docker; en lab/ca solo se copia su certificado
# raíz (público) en tiempo de ejecución. Nada de lab/ca se versiona salvo el marcador.
lab/ca/*
!lab/ca/.gitkeep
# Datos de Hermes (sesiones, memoria, .env): se generan en ejecución
hermes-data/
lab/hermes/data/

# Datos de ejecución
ollama-data/
caddy-data/
*.log
__pycache__/
.venv/

# Sistema / editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
~$*
