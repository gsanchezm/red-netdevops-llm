# Secretos: el repositorio es público. Las llaves de WireGuard, la CA de Caddy
# y las contraseñas de Ansible se generan en el servidor y nunca se versionan.
*.key
*.pem
# Ansible: archivos temporales y variables propias (van fuera del repositorio; ansible/vars.example.yml es el modelo)
.ansible/
*.retry
ansible/vars.yml
*.crt
privatekey
publickey
presharedkey
wg*.conf
.env
*.env
.vault_pass*
secrets/

# La CA interna de Caddy vive en un volumen de Docker; en lab/ca solo se copia su certificado
# raíz (público) en tiempo de ejecución. Nada de lab/ca se versiona salvo el marcador.
lab/ca/*
!lab/ca/.gitkeep
# Snapshots de estado que lee Hermes (se generan con scripts/snapshot.sh); solo se versiona el marcador
lab/snapshots/*
!lab/snapshots/.gitkeep
# Datos de Hermes (sesiones, memoria, .env): se generan en ejecución
hermes-data/
lab/hermes/data/

# Datos de ejecución
ollama-data/
caddy-data/
*.log
__pycache__/
.venv/

# Reporte final (Día 7): las dependencias de Node se reinstalan con npm install
reporte/node_modules/

# Sistema / editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
~$*
